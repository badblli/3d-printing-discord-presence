{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "3D Printing",
  "version": "0.2.0",
  "identifier": "io.github.badblli.printpresence",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "3D Printing",
        "width": 760,
        "height": 640,
        "decorations": false,
        "shadow": true,
        "resizable": false,
        "backgroundColor": "#0d1117",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src https://raw.githubusercontent.com 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGQUE0QkY0QUJEQTRDQTIKUldTaVROcXI5RXVxanh2Y0tTL0FZZkloSGtVMFhHRG5Mc2UvRzBiQmt3NTM0MkJtQWduMTdHNFYK",
      "endpoints": [
        "https://github.com/badblli/3d-printing-discord-presence/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}